      "approvedAt": "2026-06-01"
    },
    "GUIDE-DIET-FAT": {
      "title": "Ruokavalion rasvojen laatu",
      "text": "Suosi kasviöljyjä, pähkinöitä ja kalaa. Kasviksia, marjoja ja täysjyväviljaa kannattaa syödä päivittäin. Pienetkin pysyvät muutokset ovat hyödyllisiä.",
      "approvedBy": "Lääkäri (demo)",
      "approvedAt": "2026-05-20"
    },
    "GUIDE-SLEEP-ROUTINE": {
      "title": "Säännöllinen unirytmi",
      "text": "Mene nukkumaan ja herää suunnilleen samaan aikaan myös vapaapäivinä. Rauhoita viimeinen tunti ennen nukkumaanmenoa ja vältä kirkkaita näyttöjä. Pienetkin muutokset rytmissä näkyvät usein palautumisessa.",
      "approvedBy": "Sairaanhoitaja (demo)",
      "approvedAt": "2026-06-01"
    },
    "GUIDE-RECOVERY-LOAD": {
      "title": "Palautuminen kuormittavana aikana",
      "text": "Kuormittavana aikana lyhytkin rauhoittumishetki päivässä auttaa: esimerkiksi 10 minuutin kävely ulkona tai rauhallinen hengittely ennen nukkumaanmenoa. Kevennä liikuntaa hetkeksi, jos olo on väsynyt.",
      "approvedBy": "Sairaanhoitaja (demo)",
      "approvedAt": "2026-06-01"
    }
  },
